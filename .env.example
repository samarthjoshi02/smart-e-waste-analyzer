# Application Environment (development | production)
APP_ENV=development
DEBUG=True

# Server Configuration
HOST=127.0.0.1
PORT=8501

# Model & Inference Settings (Relative to PCB_Project)
MODEL_PATH=models/yolov8s_pcb_best.pt
DATASET_CONFIG=dataset/data.yaml
CONFIDENCE_THRESHOLD=0.30
IOU_THRESHOLD=0.45
IMAGE_SIZE=960

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Optional AI Environmental Advisory (Groq API)
# Leave empty to use local curated knowledge base
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Analysis History Database
HISTORY_DB_PATH=app_data/history.db

# Analysis History Database
HISTORY_DB_PATH=app_data/history.db

